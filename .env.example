# ==============================================================================
# 이메일 전송 환경 설정 (SMTP)
# ==============================================================================

# [네이버 메일 사용 시] (추천: 설정이 가장 간단함)
# 1. 네이버 메일 웹 접속 -> 환경설정(좌측 하단 톱니바퀴) -> POP3/IMAP 설정 -> IMAP/SMTP 사용 '사용함' 체크
# 2. 아래 정보 입력
SMTP_SERVER=smtp.naver.com
SMTP_PORT=587
SMTP_USER=your_naver_id@naver.com
SMTP_PASSWORD=your_naver_password
RECIPIENT_EMAIL=your_email@domain.com

# [구글 Gmail 사용 시]
# 1. 구글 계정 보안 설정 -> '2단계 인증' 활성화
# 2. '앱 비밀번호(App Password)' 생성 (16자리)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASSWORD=your_16digit_app_password
# RECIPIENT_EMAIL=your_email@domain.com

# [다음/카카오 메일 사용 시]
# SMTP_SERVER=smtp.daum.net
# SMTP_PORT=465
